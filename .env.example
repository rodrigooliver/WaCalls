# Browser calls this origin in local dev. Leave empty in the production image (same host as the API).
VITE_API_URL=http://127.0.0.1:3262

# Required in production. Empty leaves /api open (local dev).
WACALLS_API_KEY=

# Optional. Empty disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
